#!/usr/bin/env bash
# factory-auth: copy Factory Droid auth + config to the current machine using croc.
#
# On the machine you are already logged in on:
#     factory-auth send
#   It prints a croc receive code. Keep that terminal open.
#
# On the new/remote machine (after running setup.sh so croc + this script are installed):
#     factory-auth receive <code>
#
# What gets transferred:
#     ~/.factory/auth.v2.key    (encryption key for the auth token)
#     ~/.factory/auth.v2.file   (encrypted auth token; your login)
#     ~/.factory/settings.json  (default model, reasoning effort, autonomy mode,
#                                mission worker model, custom models + their API keys,
#                                model favorites, etc.)
#     ~/.factory/mcp.json       (MCP server config)
#
# Intentionally NOT transferred (machine-specific):
#     ~/.factory/host.json   (hostId, computerId, firestore org registration)
#     ~/.factory/computer.json, ~/.factory/sessions/, ~/.factory/logs/, etc.
#
# Copying the auth pair across lets you skip the re-login flow on the new machine.
# Copying settings.json/mcp.json brings over your default model and config so you
# don't have to reconfigure Factory CLI by hand.

set -euo pipefail

FACTORY_DIR="${HOME}/.factory"
KEY_FILE="${FACTORY_DIR}/auth.v2.key"
AUTH_FILE="${FACTORY_DIR}/auth.v2.file"
SETTINGS_FILE="${FACTORY_DIR}/settings.json"
MCP_FILE="${FACTORY_DIR}/mcp.json"

# Files to send. Auth files are required; settings/mcp are optional (warn if missing).
AUTH_REQUIRED=("$KEY_FILE" "$AUTH_FILE")
CONFIG_OPTIONAL=("$SETTINGS_FILE" "$MCP_FILE")

usage() {
  cat <<USAGE
Usage:
  factory-auth send                 # run on the logged-in machine
  factory-auth receive <code>       # run on the new machine
USAGE
}

cmd_send() {
  # Verify required auth files exist.
  local missing=()
  for f in "${AUTH_REQUIRED[@]}"; do
    [[ -f "$f" ]] || missing+=("$f")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "error: Factory auth files not found: ${missing[*]}" >&2
    echo "       Make sure you are logged in to Factory CLI on this machine." >&2
    exit 1
  fi

  # Build the list of files to send, including optional config files that exist.
  local send_files=("${AUTH_REQUIRED[@]}")
  for f in "${CONFIG_OPTIONAL[@]}"; do
    if [[ -f "$f" ]]; then
      send_files+=("$f")
    else
      echo "warning: optional config file not found, skipping: $f" >&2
    fi
  done

  echo "Sending Factory auth + config (${#send_files[@]} files)..."
  # croc prints a one-time receive code to stdout. --yes skips prompts on the sender side.
  croc send --yes "${send_files[@]}"
}

cmd_receive() {
  local code="${1:-}"
  if [[ -z "$code" ]]; then
    echo "error: missing receive code." >&2
    usage
    exit 1
  fi

  mkdir -p "$FACTORY_DIR"

  # Receive into ~/.factory, overwriting any existing files. croc preserves
  # filenames, so they land at the right paths.
  croc --yes --overwrite --out "$FACTORY_DIR" "$code"

  # Tighten perms on auth + config so other users can't read credentials/secrets.
  chmod 600 "$KEY_FILE" "$AUTH_FILE" "$SETTINGS_FILE" "$MCP_FILE" 2>/dev/null || true

  echo
  echo "Factory auth + config restored to ${FACTORY_DIR}."
  echo "  - auth:        ${KEY_FILE}, ${AUTH_FILE}"
  echo "  - settings:     ${SETTINGS_FILE}"
  echo "  - mcp servers:  ${MCP_FILE}"
  echo
  echo "Run 'droid' (or whatever invokes the Factory CLI) to verify."
}

case "${1:-}" in
  send)    cmd_send ;;
  receive) shift || true; cmd_receive "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "unknown command: ${1:-}" >&2; usage; exit 1 ;;
esac
