# Baseten API key for Factory custom models
# Get your key from: https://app.baseten.co/settings
BASETEN_API_KEY=your_key_here

# Factory API key for the droid CLI (env-var auth, alternative to OAuth).
# Get your key from: https://app.factory.ai/settings
# When set, setup.sh / brew-setup.sh persist `export FACTORY_API_KEY=...` to
# your shell rc files (~/.bashrc, ~/.zshrc) so the droid CLI reads it from the
# environment. Leave blank to keep using OAuth (~/.factory/auth.v2.file).
FACTORY_API_KEY=your_key_here

# GitHub token with repo scope (private repos: dsingal0/remote_agent). Used by
# setup to clone carry during bootstrap, before devpod-bundle restores SSH keys.
# Create: https://github.com/settings/tokens (classic, repo scope, or fine-grained).
GITHUB_TOKEN=your_token_here
