# training shortcuts
# -----------------

mark_training_node_expired() {
  if [ -z "$1" ]; then
    echo "Usage: mark_training_node_expired <node_name>"
    return 1
  fi
  NODE=$(kubectl get node $1 -o jsonpath='{.metadata.name}')
  if [ -z "$NODE" ]; then
    echo "Node $1 not found"
    return 1
  fi
  kubectl taint node $1 baseten-internal/training-manual-no-schedule=present:NoSchedule
  kubectl label node $1 baseten-internal/training-manual-no-schedule=present
  # get the overprovisioning pod on the input node and delete it. This will cause it to reschedule, which it will be forced to do
  # on the next node.
  # Find the the pod that is deployed on the input node and delete it.
  OVERPROVISIONING_POD=$(kubectl get pods -n overprovisioning -l app=hold-flex-dws-h100-4b-1b-training -o json | jq -r ".items[] | select(.spec.nodeName == \"$1\") | .metadata.name" | head -n 1)
  kubectl delete pod -n overprovisioning $OVERPROVISIONING_POD
  echo "Marked node $1 as expired"
}

unmark_training_node_expired() {
  if [ -z "$1" ]; then
    echo "Usage: unmark_training_node_expired <node_name>"
    return 1
  fi
  NODE=$(kubectl get node $1 -o jsonpath='{.metadata.name}')
  if [ -z "$NODE" ]; then
    echo "Node $1 not found"
    return 1
  fi
  kubectl taint node $1 baseten-internal/training-manual-no-schedule-
  kubectl label node --overwrite $1 baseten-internal/training-manual-no-schedule-
  echo "Unmarked node $1 as expired"
}

