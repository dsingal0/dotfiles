# Connect to node via SSM (get node name from `kubectl get nodes` or elsewhere)
# Note - this only works for AWS clusters
kssh-node() {
  NODE_ID=$(kubectl get node -o jsonpath="{.spec.providerID}" $1 | sed -e 's/.*\///')
  aws ssm start-session --target $NODE_ID
}

# aws-vault sync - Sets the kube context based on the current AWS vault name
# See docs/local-dev/AWS-&-Terraform-Setup.md for setup
# Usage: avs   # no args needed
avs() {
  # By overriding this, we keep the kubeconfig scoped to the current env
  export KUBECONFIG=~/.kube/$AWS_VAULT.config
  aws eks update-kubeconfig --name $AWS_VAULT
}

# aws-vault refresh - Refreshes the aws-vault permissions after a timeout
# Usage: avr   # no args needed
avr() {
  local AWS_VAULT_ORIG=$AWS_VAULT
  (AWS_VAULT="" aws-vault exec $AWS_VAULT_ORIG -- /bin/bash -c "export | grep AWS_") >/tmp/aws_creds.txt
  source /tmp/aws_creds.txt
  rm /tmp/aws_creds.txt
}

# gks set - Sets the kube context to the given environment
# Usage: gks [prod|staging|dev] # uses first WP for each environment
# Usage: gks <workload-plane-name>
gkss() {
  case $1 in
  prod|us-east4-prod-1)
    local PROJECT_NAME=production-workload-plane-1
    local CLUSTER_NAME=us-east4-prod-1
    local REGION=us-east4
    ;;
  us-central1-prod-1)
    local PROJECT_NAME=production-wp-us-central-1
    local CLUSTER_NAME=us-central1-prod-1
    local REGION=us-central1
    ;;
  staging|us-central1-staging)
    local PROJECT_NAME=staging-workload-plane-1
    local CLUSTER_NAME=us-central1-staging
    local REGION=us-central1
    ;;
  dev|wp-gcp-us-central1-dev)
    local PROJECT_NAME=multi-cluster-gcp
    local CLUSTER_NAME=wp-gcp-us-central1-dev
    local REGION=us-central1
    ;;
  *)
    echo "Unknown environment $1"
    return 1
    ;;
  esac
  export KUBECONFIG=~/.kube/gke_$1.config
  gcloud container clusters get-credentials $CLUSTER_NAME --region $REGION --project $PROJECT_NAME
}

