commit() {

    # Check if a comment argument is provided
    if [ -z "$1" ]; then
    echo "Usage: $0 <commit_message>"
    exit 1
    fi

    comment="$1"
    previous_output=""

    # Define the regex pattern to match the desired output format
    pattern="[0-9]+ files? changed"

    while true; do
    git add .

    # Use a temporary file to capture the output
    temp_file=$(mktemp)

    # Stream the output of the git commit command and capture it
    git commit -m "$comment" 2>&1 | tee "$temp_file"
    output=$(cat "$temp_file")

    # Save the exit status of the git commit command
    commit_exit_status=$?

    # Print the output to the terminal
    echo "$output"

    # Check if the output matches the desired pattern
    if [[ $output =~ $pattern ]]; then
        echo "Commit successful with matching output:"
        echo "$output"
        break
    fi

    # Check if the output is the same as the previous attempt
    if [[ "$output" == "$previous_output" ]]; then
        echo "Output is the same as the previous attempt. Exiting."
        break
    else
        previous_output="$output"
    fi

    # Remove the temporary file
    rm "$temp_file"
    done

}

# Get a shell in a pod
# Usage: ksh <podname>
ksh() {
  kubectl exec -it $1 -- /bin/bash
}

# Get a shell or run a command in a django pod
# Usage:
# kshd  # get a shell
# kshd <command> <args...>  # run a command
kshd() {
  DJANGO_POD=$(kubectl get pods -n baseten -o name | grep celery-worker | awk -F/ '{ print $2 }' | head -n 1)
  if [ $# -eq 0 ]; then
    kubectl exec -it -n baseten -c celery-worker $DJANGO_POD -- /bin/bash
  else
    kubectl exec -it -n baseten -c celery-worker $DJANGO_POD -- "$@"
  fi
}

kshp() {
  kshd uv run python manage.py shell_plus
}

