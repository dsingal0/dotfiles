#!/usr/bin/env bash
# devpod-bundle - pack auth + settings for SSH, omp (oh-my-pi), factory droid,
# cursor CLI, grok CLI, and truss (Baseten) into a single tar.gz so they can
# be sent via croc to a dev pod and unpacked into the right locations.
#
# Two modes:
#
#   bundle  (default)  - run on the Mac you stay logged in on. Reads the
#                       local auth/settings files and writes a timestamped
#                       ~/devpod-bundle-<stamp>.tar.gz (mode 600).
#   restore (--restore <file>.tar.gz)
#                     - run on the dev pod. Extracts a bundle into $HOME,
#                       skipping the embedded RESTORE.txt note (which is
#                       printed to stdout instead of littering ~).
#
# Paths in the archive are stored RELATIVE TO $HOME (e.g. ./.ssh/id_ed25519,
# ./.omp/agent/models.yml), so on any pod you can also just:
#
#     cd ~ && tar -xzf devpod-bundle-*.tar.gz
#
# regardless of the pod's username. The --restore mode does exactly that,
# minus the RESTORE.txt note.
#
# omp (oh-my-pi) config lives in ~/.omp/agent/ (models.yml with the Baseten
# API key inline, config.yml with roles + fallback chain, mcp.json, and the
# AGENTS.md symlink target config/omp/AGENTS.md from this dotfiles repo).
# Bundling agent/ restores the full harness config on the pod; the models.yml
# key is verified on restore. The runlayer MCP OAuth credential is NOT a file:
# omp keeps it in agent.db (auth_credentials table), so it is extracted into
# .omp/agent/mcp-runlayer-auth.json in the archive and merged into the pod's
# agent.db on restore. agent.db itself is excluded (machine-local, huge).
#
# Settings sync: this bundle IS the transport for omp settings to dev pods
# (live models.yml / config.yml / mcp.json + runlayer auth are packed fresh
# on every run). The dotfiles repo only supplies AGENTS.md + skills.

# Cursor CLI (cursor-agent) auth is file-based: set AGENT_CLI_CREDENTIAL_STORE=file
# so it writes ~/.cursor/auth.json on macOS (and reads ~/.config/cursor/auth.json
# on Linux) instead of the macOS Keychain. That auth.json IS bundled; on restore
# it is copied to ~/.config/cursor/auth.json on Linux. ~/.cursor/env (CURSOR_API_KEY)
# is also bundled and sourced by shell rc (legacy, kept for compatibility).
#
# factory droid auth is file-based too: set FACTORY_DISABLE_KEYRING=1 so droid
# writes the portable ~/.factory/auth.v2.file + auth.v2.key pair instead of the
# macOS login keychain (auth.v2.loginkeychain, which is NOT portable to Linux).
# The auth.v2.file/key pair IS bundled.
#
# The output file is mode 600 (it contains secrets). Re-run anytime; each
# bundle produces a new timestamped archive and leaves old ones in place.
#
# Usage:
#   devpod-bundle                          # write ~/devpod-bundle-<stamp>.tar.gz
#   devpod-bundle --list                   # show what would be packed, write nothing
#   devpod-bundle -o /tmp/x.tgz            # write to a custom path
#   devpod-bundle --restore <bundle>.tar.gz        # extract into $HOME (pod)
#   devpod-bundle --restore <bundle>.tar.gz --dry-run  # list only, extract nothing

set -euo pipefail

HOME_DIR="${HOME:?HOME is not set}"

# Return 0 if the given omp models.yml contains at least one provider with an
# inline apiKey — the way this dotfiles setup stores the Baseten key
# (providers.baseten.apiKey). Return 1 otherwise. Used to verify omp
# credentials on restore.
omp_models_yml_has_inline_key() {
  local cfg="$1"
  [[ -f "$cfg" ]] || return 1
  python3 - "$cfg" <<'PYEOF'
import sys
try:
    with open(sys.argv[1]) as f:
        for line in f:
            s = line.split(":", 1)
            if len(s) == 2 and s[0].strip() == "apiKey":
                value = s[1].strip().strip('"').strip("'")
                if value and not value.startswith("$"):
                    sys.exit(0)
except Exception:
    sys.exit(1)
sys.exit(1)
PYEOF
}

# Dump omp's runlayer MCP OAuth credential row (from ~/.omp/agent/agent.db,
# auth_credentials table) as JSON on stdout, or nothing if not present. The row
# travels in the archive as .omp/agent/mcp-runlayer-auth.json and is merged
# into the pod's agent.db by --restore (omp keeps MCP OAuth tokens only there;
# there is no standalone runlayer auth file).
omp_runlayer_auth_row() {
  python3 - << 'PYEOF'
import json, os, sqlite3, sys

db = os.path.expanduser("~/.omp/agent/agent.db")
if not os.path.exists(db):
    sys.exit(0)
try:
    con = sqlite3.connect(db)
    rows = con.execute(
        "SELECT provider, credential_type, identity_key, data FROM auth_credentials "
        "WHERE provider LIKE 'mcp_oauth:%runlayer.com/mcp' "
        "ORDER BY updated_at DESC LIMIT 1"
    ).fetchall()
    con.close()
except sqlite3.Error:
    sys.exit(0)
if rows:
    provider, cred_type, identity_key, data = rows[0]
    print(json.dumps({
        "provider": provider,
        "credential_type": cred_type,
        "identity_key": identity_key,
        "data": data,
    }))
PYEOF
}

# Merge a bundled .omp/agent/mcp-runlayer-auth.json into this machine's omp
# agent.db (upsert by provider) and remove the staged file; if agent.db does
# not exist yet (omp never ran here), leave the file and say what to do.
omp_merge_runlayer_auth() {
  local src="$HOME_DIR/.omp/agent/mcp-runlayer-auth.json"
  [[ -f "$src" ]] || return 0
  python3 - "$src" << 'PYEOF'
import json, os, sqlite3, sys

src, db = sys.argv[1], os.path.expanduser("~/.omp/agent/agent.db")
with open(src) as f:
    row = json.load(f)
if not os.path.exists(db):
    print("runlayer mcp auth: agent.db not found (omp has not run here yet).")
    print("  Staged at ~/.omp/agent/mcp-runlayer-auth.json; start omp once,")
    print("  then re-run: devpod-bundle --restore (to finish the merge).")
    sys.exit(0)
con = sqlite3.connect(db)
con.execute("DELETE FROM auth_credentials WHERE provider = ?", (row["provider"],))
con.execute(
    "INSERT INTO auth_credentials (provider, credential_type, data, identity_key) "
    "VALUES (?, ?, ?, ?)",
    (row["provider"], row["credential_type"], row["data"], row.get("identity_key")),
)
con.commit()
con.close()
os.remove(src)
print("runlayer mcp auth: merged into ~/.omp/agent/agent.db (restart omp to use it)")
PYEOF
}

# --------------------------------------------------------------------------- args
OUT=""
LIST_ONLY=0
RESTORE_FILE=""
DRY_RUN=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)  OUT="$2"; shift 2 ;;
    --list)       LIST_ONLY=1; shift ;;
    --restore)    RESTORE_FILE="$2"; shift 2 ;;
    --dry-run)    DRY_RUN=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --------------------------------------------------------------------------- restore
if [ -n "$RESTORE_FILE" ]; then
  if [ ! -f "$RESTORE_FILE" ]; then
    echo "restore: not a file: $RESTORE_FILE" >&2
    exit 1
  fi
  if ! tar -tzf "$RESTORE_FILE" >/dev/null 2>&1; then
    echo "restore: not a gzip tar archive: $RESTORE_FILE" >&2
    exit 1
  fi

  echo "Bundle contents ($RESTORE_FILE):"
  tar -tzf "$RESTORE_FILE" | sed 's/^/  /'

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "(--dry-run: nothing extracted)"
    exit 0
  fi

  echo
  echo "Extracting into $HOME_DIR ..."
  # Skip the embedded RESTORE.txt note so it doesn't litter ~; print it below.
  tar -xzf "$RESTORE_FILE" -C "$HOME_DIR" --exclude=RESTORE.txt

  # cursor-agent reads its file-store auth at ~/.cursor/auth.json on macOS but
  # ~/.config/cursor/auth.json on Linux. The bundle stores it as .cursor/auth.json;
  # on a Linux pod, place it where the CLI actually looks for it.
  if [[ "$(uname -s)" != "Darwin" && -f "$HOME_DIR/.cursor/auth.json" ]]; then
    mkdir -p "$HOME_DIR/.config/cursor"
    cp -f "$HOME_DIR/.cursor/auth.json" "$HOME_DIR/.config/cursor/auth.json"
    chmod 600 "$HOME_DIR/.config/cursor/auth.json"
    echo "cursor auth: placed ~/.cursor/auth.json at ~/.config/cursor/auth.json (Linux path)"
  fi

  # Merge the bundled runlayer MCP OAuth credential into omp's agent.db (or
  # leave it staged if omp has not created agent.db yet — the helper prints
  # what to do in that case).
  omp_merge_runlayer_auth

  # Verify omp config landed (models.yml with an inline apiKey, written by
  # configure_omp in the dotfiles setup).
  if omp_models_yml_has_inline_key "$HOME_DIR/.omp/agent/models.yml"; then
    echo "omp config: OK (~/.omp/agent/models.yml with inline apiKey)"
  else
    echo "WARNING: no omp models.yml with an inline apiKey found after restore"
    echo "         — run the dotfiles setup (configure_omp) on this pod."
  fi

  if tar -tzf "$RESTORE_FILE" | grep -qx 'RESTORE.txt'; then
    echo
    echo "----- RESTORE.txt (from bundle) -----"
    tar -xzOf "$RESTORE_FILE" RESTORE.txt
    echo "----- end RESTORE.txt -----"
  fi
  exit 0
fi

# --------------------------------------------------------------------------- bundle
STAMP="$(date +%Y%m%d-%H%M%S)"
DEFAULT_OUT="$HOME_DIR/devpod-bundle-$STAMP.tar.gz"
[ -z "$OUT" ] && OUT="$DEFAULT_OUT"

# Absolute source paths. All must live under $HOME. Each entry is bundled
# recursively (if a dir) or as a single file. Built incrementally so missing
# optional files can be skipped cleanly.
abs_paths=()
labels=()

# ssh (always bundled)
abs_paths+=("$HOME_DIR/.ssh")
labels+=("ssh (dir)")

# omp (oh-my-pi): the whole agent config dir — models.yml (Baseten key inline),
# config.yml (roles + fallback chain), mcp.json (runlayer), and the AGENTS.md
# symlink. agent.db / history.db / caches are excluded (machine-local, huge).
# Bundling models.yml + config.yml is what re-auths and re-configures omp on
# the pod; --restore verifies the inline apiKey landed.
abs_paths+=("$HOME_DIR/.omp/agent/models.yml")
labels+=("omp models (Baseten provider, inline key)")
abs_paths+=("$HOME_DIR/.omp/agent/config.yml")
labels+=("omp roles + fallback chain")
abs_paths+=("$HOME_DIR/.omp/agent/mcp.json")
labels+=("omp MCP servers (runlayer)")


# factory droid
abs_paths+=(
  "$HOME_DIR/.factory/auth.v2.file"
  "$HOME_DIR/.factory/auth.v2.key"
  "$HOME_DIR/.factory/auth.v2.loginkeychain"
  "$HOME_DIR/.factory/cache/certs/factory-cli-certs.pem"
  "$HOME_DIR/.factory/settings.json"
  "$HOME_DIR/.factory/mission-readiness-warnings-shown.json"
  "$HOME_DIR/.factory/droids"
  "$HOME_DIR/.factory/crons"
)
labels+=(
  "factory droid auth (login file)"
  "factory droid auth (login key)"
  "factory droid auth (login keychain)"
  "factory droid auth (mTLS cert)"
  "factory droid settings (custom models, session defaults, trusted folders)"
  "factory droid mission prefs (readiness warnings shown)"
  "factory droid custom droids (dir)"
  "factory droid cron missions (dir)"
)

# cursor CLI
abs_paths+=(
  "$HOME_DIR/.cursor/cli-config.json"
  "$HOME_DIR/.cursor/agent-cli-state.json"
  "$HOME_DIR/.cursor/env"
  "$HOME_DIR/.cursor/auth.json"
)
labels+=(
  "cursor CLI settings"
  "cursor CLI state"
  "cursor CLI auth (API key)"
  "cursor CLI auth (file store: ~/.cursor/auth.json)"
)

# grok CLI
abs_paths+=(
  "$HOME_DIR/.grok/auth.json"
  "$HOME_DIR/.grok/config.toml"
)
labels+=(
  "grok CLI auth"
  "grok CLI settings"
)

# truss (Baseten) CLI
abs_paths+=("$HOME_DIR/.trussrc")
labels+=("truss CLI credentials (Baseten remotes)")

if [ "${#abs_paths[@]}" -ne "${#labels[@]}" ]; then
  echo "internal error: abs_paths/labels length mismatch" >&2
  exit 1
fi

rel_paths=()
present_labels=()
missing=()
for i in "${!abs_paths[@]}"; do
  p="${abs_paths[$i]}"
  lbl="${labels[$i]}"
  if [ ! -e "$p" ]; then
    missing+=("$lbl  ($p)")
    continue
  fi
  case "$p" in
    "$HOME_DIR"/*) rel="${p#"$HOME_DIR"/}" ;;
    *) echo "skipping path not under \$HOME: $p" >&2; continue ;;
  esac
  rel_paths+=("$rel")
  present_labels+=("$lbl -> ~/$rel")
done

# How omp credentials travel in this bundle: models.yml carries the Baseten
# key inline (written by configure_omp in the dotfiles setup). Warn loudly
# if it is missing.
omp_cred_note=""
if omp_models_yml_has_inline_key "$HOME_DIR/.omp/agent/models.yml"; then
  omp_cred_note="omp auth: bundled inline in ~/.omp/agent/models.yml (providers.baseten.apiKey)"
else
  omp_cred_note="WARNING: no omp models.yml with an inline apiKey found — omp will be unauthenticated on the pod"
fi

if [ ${#rel_paths[@]} -eq 0 ]; then
  echo "nothing to bundle (no source paths found under $HOME_DIR)" >&2
  exit 1
fi

echo "Bundling from $HOME_DIR:"
printf '  %s\n' "${present_labels[@]}"
echo "  $omp_cred_note"
if [ ${#missing[@]} -gt 0 ]; then
  echo "missing (skipped):"
  printf '  %s\n' "${missing[@]}" >&2
fi

# omp runlayer MCP OAuth credential: extracted from agent.db into the staging
# dir so it lands in the archive at .omp/agent/mcp-runlayer-auth.json. --restore
# merges it back into the pod's agent.db (omp stores MCP OAuth tokens there).
STAGE_MCP_AUTH=""
if omp_runlayer_auth_row > "$HOME_DIR/.omp/agent/.mcp-auth-row.tmp" 2>/dev/null \
   && [ -s "$HOME_DIR/.omp/agent/.mcp-auth-row.tmp" ]; then
  STAGE_MCP_AUTH="mcp-runlayer-auth.json"
else
  rm -f "$HOME_DIR/.omp/agent/.mcp-auth-row.tmp"
  missing+=("omp runlayer MCP OAuth credential (not in agent.db — run \`omp\` and auth runlayer first)  (~/.omp/agent/agent.db)")
fi

if [ "$LIST_ONLY" -eq 1 ]; then
  if [ -n "$STAGE_MCP_AUTH" ]; then
    echo "  omp runlayer MCP auth -> ~/.omp/agent/mcp-runlayer-auth.json (from agent.db)"
  fi
  rm -f "$HOME_DIR/.omp/agent/.mcp-auth-row.tmp"
  exit 0
fi

# Companion note placed at the archive root so the pod knows what it has and
# how to restore it.
TMP_BUNDLE="$(mktemp -d)"
trap 'rm -rf "$TMP_BUNDLE"' EXIT
if [ -n "$STAGE_MCP_AUTH" ]; then
  mkdir -p "$TMP_BUNDLE/.omp/agent"
  mv "$HOME_DIR/.omp/agent/.mcp-auth-row.tmp" "$TMP_BUNDLE/.omp/agent/mcp-runlayer-auth.json"
  chmod 600 "$TMP_BUNDLE/.omp/agent/mcp-runlayer-auth.json"
fi
{
  echo "devpod-bundle"
  echo "============="
  echo "created:   $(date)"
  echo "source:    $(hostname)  (user: $(whoami), home: $HOME_DIR)"
  echo
  echo "Contents (paths relative to \$HOME):"
  printf '  %s\n' "${present_labels[@]}"
  if [ ${#missing[@]} -gt 0 ]; then
    echo
    echo "Not bundled on source host:"
    printf '  %s\n' "${missing[@]}"
  fi
  echo
  echo "Transport the bundle to the pod (any one of):"
  echo "  croc send <bundle>.tar.gz          # pod: croc <code>"
  echo "  wormhole send <bundle>.tar.gz      # pod: wormhole receive <code>"
  echo "  rsync -av <bundle>.tar.gz <pod>:   # or plain scp"
  echo
  echo "Restore on the pod:"
  echo "  ~/dotfiles/devpod-bundle --restore <bundle>.tar.gz"
  echo "  (or: cd ~ && tar -xzf <bundle>.tar.gz)"
  echo
  echo "Notes:"
  echo "  - File permissions are preserved (ssh keys stay 0600, etc.)."
  echo "  - Cursor CLI auth IS included via ~/.cursor/auth.json (file store;"
  echo "    set AGENT_CLI_CREDENTIAL_STORE=file so cursor-agent writes it instead"
  echo "    of the macOS Keychain). On Linux it is placed at ~/.config/cursor/auth.json"
  echo "    by --restore. Run \`agent status\` on the pod to verify. ~/.cursor/env"
  echo "    (CURSOR_API_KEY) is bundled too but is legacy (not read by cursor-agent)."
  echo "  - factory droid auth (auth.v2.file + auth.v2.key) IS bundled. On the Mac"
  echo "    set FACTORY_DISABLE_KEYRING=1 so droid writes that portable pair instead"
  echo "    of the macOS login keychain (auth.v2.loginkeychain is NOT portable to"
  echo "    Linux). If the mTLS cert has expired on the pod, re-run \`factory login\`."
  echo "  - factory droid settings/preferences ARE bundled: settings.json"
  echo "    (custom models, session defaults, trusted folders), custom droids"
  echo "    (~/.factory/droids), and cron missions (~/.factory/crons)."
  echo "  - omp (oh-my-pi) config: bundled from ~/.omp/agent/ — models.yml"
  echo "    (Baseten key inline, as this dotfiles setup writes), config.yml"
  echo "    (roles + fallback chain), and mcp.json. --restore verifies the"
  echo "    inline apiKey landed. Skills/AGENTS.md symlinks come from the"
  echo "    dotfiles repo on the pod, not from this bundle."
  echo "  - $omp_cred_note"
  echo "  - truss (Baseten) credentials ARE bundled via ~/.trussrc. If the"
  echo "    remote needs re-auth on the pod, run \`truss login\`."
  echo "  - omp runlayer MCP auth (OAuth token from agent.db) IS bundled at"
  echo "    .omp/agent/mcp-runlayer-auth.json; --restore merges it into the"
  echo "    pod's ~/.omp/agent/agent.db. If it has expired there, re-auth"
  echo "    runlayer from omp on the pod."
} > "$TMP_BUNDLE/RESTORE.txt"

# Build the archive. Paths are stored relative to $HOME via -C "$HOME_DIR";
# RESTORE.txt (and the staged runlayer MCP auth json, if any) are added from
# the temp dir with a second -C. Excludes drop the stale known_hosts backup
# and any stray agent sockets.
tar_extra=()
[ -n "$STAGE_MCP_AUTH" ] && tar_extra+=(".omp/agent/mcp-runlayer-auth.json")
tar -czf "$OUT" \
  --exclude='.ssh/known_hosts.old' \
  --exclude='*.sock' \
  -C "$HOME_DIR" "${rel_paths[@]}" \
  -C "$TMP_BUNDLE" RESTORE.txt "${tar_extra[@]}"

chmod 600 "$OUT"

echo
echo "wrote: $OUT  ($(du -h "$OUT" | cut -f1))"
echo
echo "archive contents:"
tar -tzf "$OUT" | sed 's/^/  /'
echo
echo "send it:   croc send \"$OUT\""
echo "           (or) magic-wormhole:  wormhole send \"$OUT\""
echo "                (wormhole is the ~/venv magic-wormhole CLI, symlinked"
echo "                 to ~/.local/bin/wormhole by ensure_venv in the setup)"
echo "           (or) rsync:           rsync -av \"$OUT\" <pod>:"
echo
echo "receive on the pod:"
echo "           croc           -> croc <code>          (asks for the code)"
echo "           magic-wormhole -> wormhole receive <code>   (auto-named file)"
echo "                (the pod gets the same ~/.local/bin/wormhole symlink"
echo "                 from ~/venv via ensure_venv in the dotfiles setup)"
echo
echo "restore:   ~/dotfiles/devpod-bundle --restore \"$OUT\"   (on the pod)"
