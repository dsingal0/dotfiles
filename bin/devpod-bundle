#!/usr/bin/env bash
# devpod-bundle - pack auth + settings for SSH, opencode, factory droid,
# cursor CLI, grok CLI, and truss (Baseten) into a single tar.gz so they can
# be sent via croc to a dev pod and unpacked into the right locations.
#
# Two modes:
#
#   bundle  (default)  - run on the Mac you stay logged in on. Reads the
#                       local auth/settings files and writes a timestamped
#                       ~/devpod-bundle-<stamp>.tar.gz (mode 600).
#   restore (--restore <file>.tar.gz)
#                     - run on the dev pod. Extracts a bundle into $HOME,
#                       skipping the embedded RESTORE.txt note (which is
#                       printed to stdout instead of littering ~).
#
# Paths in the archive are stored RELATIVE TO $HOME (e.g. ./.ssh/id_ed25519,
# ./.local/share/opencode/auth.json), so on any pod you can also just:
#
#     cd ~ && tar -xzf devpod-bundle-*.tar.gz
#
# regardless of the pod's username. The --restore mode does exactly that,
# minus the RESTORE.txt note.
#
# opencode v2 (opencode2) auth lives in ~/.local/share/opencode/auth.json and
# settings live in ~/.config/opencode/cli.json; global opencode.json is bundled
# too. Only v2 is installed now; the v1 (opencode-ai) cases are gone.
#
# Cursor CLI (cursor-agent) auth is file-based: set AGENT_CLI_CREDENTIAL_STORE=file
# so it writes ~/.cursor/auth.json on macOS (and reads ~/.config/cursor/auth.json
# on Linux) instead of the macOS Keychain. That auth.json IS bundled; on restore
# it is copied to ~/.config/cursor/auth.json on Linux. ~/.cursor/env (CURSOR_API_KEY)
# is also bundled and sourced by shell rc (legacy, kept for compatibility).
#
# factory droid auth is file-based too: set FACTORY_DISABLE_KEYRING=1 so droid
# writes the portable ~/.factory/auth.v2.file + auth.v2.key pair instead of the
# macOS login keychain (auth.v2.loginkeychain, which is NOT portable to Linux).
# The auth.v2.file/key pair IS bundled.
#
# The output file is mode 600 (it contains secrets). Re-run anytime; each
# bundle produces a new timestamped archive and leaves old ones in place.
#
# Usage:
#   devpod-bundle                          # write ~/devpod-bundle-<stamp>.tar.gz
#   devpod-bundle --list                   # show what would be packed, write nothing
#   devpod-bundle -o /tmp/x.tgz            # write to a custom path
#   devpod-bundle --restore <bundle>.tar.gz        # extract into $HOME (pod)
#   devpod-bundle --restore <bundle>.tar.gz --dry-run  # list only, extract nothing

set -euo pipefail

HOME_DIR="${HOME:?HOME is not set}"

# --------------------------------------------------------------------------- args
OUT=""
LIST_ONLY=0
RESTORE_FILE=""
DRY_RUN=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)  OUT="$2"; shift 2 ;;
    --list)       LIST_ONLY=1; shift ;;
    --restore)    RESTORE_FILE="$2"; shift 2 ;;
    --dry-run)    DRY_RUN=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --------------------------------------------------------------------------- restore
if [ -n "$RESTORE_FILE" ]; then
  if [ ! -f "$RESTORE_FILE" ]; then
    echo "restore: not a file: $RESTORE_FILE" >&2
    exit 1
  fi
  if ! tar -tzf "$RESTORE_FILE" >/dev/null 2>&1; then
    echo "restore: not a gzip tar archive: $RESTORE_FILE" >&2
    exit 1
  fi

  echo "Bundle contents ($RESTORE_FILE):"
  tar -tzf "$RESTORE_FILE" | sed 's/^/  /'

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "(--dry-run: nothing extracted)"
    exit 0
  fi

  echo
  echo "Extracting into $HOME_DIR ..."
  # Skip the embedded RESTORE.txt note so it doesn't litter ~; print it below.
  tar -xzf "$RESTORE_FILE" -C "$HOME_DIR" --exclude=RESTORE.txt

  # cursor-agent reads its file-store auth at ~/.cursor/auth.json on macOS but
  # ~/.config/cursor/auth.json on Linux. The bundle stores it as .cursor/auth.json;
  # on a Linux pod, place it where the CLI actually looks for it.
  if [[ "$(uname -s)" != "Darwin" && -f "$HOME_DIR/.cursor/auth.json" ]]; then
    mkdir -p "$HOME_DIR/.config/cursor"
    cp -f "$HOME_DIR/.cursor/auth.json" "$HOME_DIR/.config/cursor/auth.json"
    chmod 600 "$HOME_DIR/.config/cursor/auth.json"
    echo "cursor auth: placed ~/.cursor/auth.json at ~/.config/cursor/auth.json (Linux path)"
  fi

  echo "done."

  if tar -tzf "$RESTORE_FILE" | grep -qx 'RESTORE.txt'; then
    echo
    echo "----- RESTORE.txt (from bundle) -----"
    tar -xzOf "$RESTORE_FILE" RESTORE.txt
    echo "----- end RESTORE.txt -----"
  fi
  exit 0
fi

# --------------------------------------------------------------------------- bundle
STAMP="$(date +%Y%m%d-%H%M%S)"
DEFAULT_OUT="$HOME_DIR/devpod-bundle-$STAMP.tar.gz"
[ -z "$OUT" ] && OUT="$DEFAULT_OUT"

# Absolute source paths. All must live under $HOME. Each entry is bundled
# recursively (if a dir) or as a single file. Built incrementally so missing
# optional files can be skipped cleanly.
abs_paths=()
labels=()

# ssh (always bundled)
abs_paths+=("$HOME_DIR/.ssh")
labels+=("ssh (dir)")

# opencode v2: /connect credentials in auth.json, cli.json settings, and the
# global opencode.json config — all bundled.
abs_paths+=("$HOME_DIR/.local/share/opencode/auth.json")
labels+=("opencode auth")
abs_paths+=("$HOME_DIR/.config/opencode/cli.json")
labels+=("opencode2 CLI/TUI settings")
abs_paths+=("$HOME_DIR/.config/opencode/opencode.json")
labels+=("opencode settings")

# factory droid
abs_paths+=(
  "$HOME_DIR/.factory/auth.v2.file"
  "$HOME_DIR/.factory/auth.v2.key"
  "$HOME_DIR/.factory/auth.v2.loginkeychain"
  "$HOME_DIR/.factory/cache/certs/factory-cli-certs.pem"
  "$HOME_DIR/.factory/settings.json"
  "$HOME_DIR/.factory/mission-readiness-warnings-shown.json"
  "$HOME_DIR/.factory/droids"
  "$HOME_DIR/.factory/crons"
)
labels+=(
  "factory droid auth (login file)"
  "factory droid auth (login key)"
  "factory droid auth (login keychain)"
  "factory droid auth (mTLS cert)"
  "factory droid settings (custom models, session defaults, trusted folders)"
  "factory droid mission prefs (readiness warnings shown)"
  "factory droid custom droids (dir)"
  "factory droid cron missions (dir)"
)

# cursor CLI
abs_paths+=(
  "$HOME_DIR/.cursor/cli-config.json"
  "$HOME_DIR/.cursor/agent-cli-state.json"
  "$HOME_DIR/.cursor/env"
  "$HOME_DIR/.cursor/auth.json"
)
labels+=(
  "cursor CLI settings"
  "cursor CLI state"
  "cursor CLI auth (API key)"
  "cursor CLI auth (file store: ~/.cursor/auth.json)"
)

# grok CLI
abs_paths+=(
  "$HOME_DIR/.grok/auth.json"
  "$HOME_DIR/.grok/config.toml"
)
labels+=(
  "grok CLI auth"
  "grok CLI settings"
)

# truss (Baseten) CLI
abs_paths+=("$HOME_DIR/.trussrc")
labels+=("truss CLI credentials (Baseten remotes)")

if [ "${#abs_paths[@]}" -ne "${#labels[@]}" ]; then
  echo "internal error: abs_paths/labels length mismatch" >&2
  exit 1
fi

rel_paths=()
present_labels=()
missing=()
for i in "${!abs_paths[@]}"; do
  p="${abs_paths[$i]}"
  lbl="${labels[$i]}"
  if [ ! -e "$p" ]; then
    missing+=("$lbl  ($p)")
    continue
  fi
  case "$p" in
    "$HOME_DIR"/*) rel="${p#"$HOME_DIR"/}" ;;
    *) echo "skipping path not under \$HOME: $p" >&2; continue ;;
  esac
  rel_paths+=("$rel")
  present_labels+=("$lbl -> ~/$rel")
done

if [ ${#rel_paths[@]} -eq 0 ]; then
  echo "nothing to bundle (no source paths found under $HOME_DIR)" >&2
  exit 1
fi

echo "Bundling from $HOME_DIR:"
printf '  %s\n' "${present_labels[@]}"
if [ ${#missing[@]} -gt 0 ]; then
  echo "missing (skipped):"
  printf '  %s\n' "${missing[@]}" >&2
fi

if [ "$LIST_ONLY" -eq 1 ]; then
  exit 0
fi

# Companion note placed at the archive root so the pod knows what it has and
# how to restore it.
TMP_BUNDLE="$(mktemp -d)"
trap 'rm -rf "$TMP_BUNDLE"' EXIT
{
  echo "devpod-bundle"
  echo "============="
  echo "created:   $(date)"
  echo "source:    $(hostname)  (user: $(whoami), home: $HOME_DIR)"
  echo
  echo "Contents (paths relative to \$HOME):"
  printf '  %s\n' "${present_labels[@]}"
  if [ ${#missing[@]} -gt 0 ]; then
    echo
    echo "Not bundled on source host:"
    printf '  %s\n' "${missing[@]}"
  fi
  echo
  echo "Restore on the pod:"
  echo "  ~/dotfiles/devpod-bundle --restore <bundle>.tar.gz"
  echo "  (or: cd ~ && tar -xzf <bundle>.tar.gz)"
  echo
  echo "Notes:"
  echo "  - File permissions are preserved (ssh keys stay 0600, etc.)."
  echo "  - Cursor CLI auth IS included via ~/.cursor/auth.json (file store;"
  echo "    set AGENT_CLI_CREDENTIAL_STORE=file so cursor-agent writes it instead"
  echo "    of the macOS Keychain). On Linux it is placed at ~/.config/cursor/auth.json"
  echo "    by --restore. Run \`agent status\` on the pod to verify. ~/.cursor/env"
  echo "    (CURSOR_API_KEY) is bundled too but is legacy (not read by cursor-agent)."
  echo "  - factory droid auth (auth.v2.file + auth.v2.key) IS bundled. On the Mac"
  echo "    set FACTORY_DISABLE_KEYRING=1 so droid writes that portable pair instead"
  echo "    of the macOS login keychain (auth.v2.loginkeychain is NOT portable to"
  echo "    Linux). If the mTLS cert has expired on the pod, re-run \`factory login\`."
  echo "  - factory droid settings/preferences ARE bundled: settings.json"
  echo "    (custom models, session defaults, trusted folders), custom droids"
  echo "    (~/.factory/droids), and cron missions (~/.factory/crons)."
  echo "  - opencode v2 auth IS bundled via ~/.local/share/opencode/auth.json."
  echo "    Its cli.json settings are bundled too; global opencode.json is"
  echo "    always bundled."
  echo "  - truss (Baseten) credentials ARE bundled via ~/.trussrc. If the"
  echo "    remote needs re-auth on the pod, run \`truss login\`."
} > "$TMP_BUNDLE/RESTORE.txt"

# Build the archive. Paths are stored relative to $HOME via -C "$HOME_DIR";
# RESTORE.txt is added from the temp dir with a second -C. Excludes drop the
# stale known_hosts backup and any stray agent sockets.
tar -czf "$OUT" \
  --exclude='.ssh/known_hosts.old' \
  --exclude='*.sock' \
  -C "$HOME_DIR" "${rel_paths[@]}" \
  -C "$TMP_BUNDLE" RESTORE.txt

chmod 600 "$OUT"

echo
echo "wrote: $OUT  ($(du -h "$OUT" | cut -f1))"
echo
echo "archive contents:"
tar -tzf "$OUT" | sed 's/^/  /'
echo
echo "send it:   croc send \"$OUT\""
echo "restore:   ~/dotfiles/devpod-bundle --restore \"$OUT\"   (on the pod)"
