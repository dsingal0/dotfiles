#!/usr/bin/env bash
# devpod-bundle - pack auth + settings for SSH, omp (oh-my-pi), factory droid,
# and truss (Baseten) into one tar.gz, croc it to a dev pod, restore it there —
# so you only stay logged in on one machine (your Mac).
#
# Modes:
#   bundle  (default)              run on the Mac; writes ~/devpod-bundle-<stamp>.tar.gz (mode 600)
#   restore (--restore <file>)     run on the pod; extracts into $HOME
#
# Paths in the archive are relative to $HOME, so `cd ~ && tar -xzf` restores on
# any pod regardless of username (--restore does the same, minus the note).
#
# Auth portability notes:
#   omp      ~/.omp/agent/{models.yml,config.yml,mcp.json} are bundled. Every
#            provider login is also exported from agent.db's auth_credentials
#            table to omp-auth-credentials.json and merged back on restore
#            (agent.db itself is excluded: machine-local, huge).
#   droid    set FACTORY_DISABLE_KEYRING=1 so auth lands in the portable
#            ~/.factory/auth.v2.{file,key} pair, not the macOS login keychain.
#   gh       OAuth token lives in the macOS keyring (not portable); `gh auth
#            token` stages a keyring-free hosts.yml with the token inline.
#   docker   ~/.docker/config.json holds Hub auth inline; bundles as a file.
#
# Usage:
#   devpod-bundle                                   # write a timestamped bundle
#   devpod-bundle --list                            # show what would be packed
#   devpod-bundle -o ~/bundle.tar.gz                # custom output path
#   devpod-bundle --restore <bundle> [--dry-run]    # on the pod
#
# The output file is mode 600 (it contains secrets); each run writes a new
# timestamped archive and leaves old ones in place.

set -euo pipefail

HOME_DIR="${HOME:?HOME is not set}"

# Return 0 if the given omp models.yml contains at least one provider with an
# inline apiKey — the way this dotfiles setup stores the Baseten key
# (providers.baseten.apiKey). Return 1 otherwise. Used to verify omp
# credentials on restore.
omp_models_yml_has_inline_key() {
  local cfg="$1"
  [[ -f "$cfg" ]] || return 1
  python3 - "$cfg" <<'PYEOF'
import sys
try:
    with open(sys.argv[1]) as f:
        for line in f:
            s = line.split(":", 1)
            if len(s) == 2 and s[0].strip() == "apiKey":
                value = s[1].strip().strip('"').strip("'")
                if value and not value.startswith("$"):
                    sys.exit(0)
except Exception:
    sys.exit(1)
sys.exit(1)
PYEOF
}

# Dump every OMP credential from ~/.omp/agent/agent.db as one JSON document.
# The auth_credentials table contains OAuth/API credentials for all providers;
# do not special-case a provider here because new OMP logins must travel too.
omp_auth_credentials_json() {
  python3 - << 'PYEOF'
import json, os, sqlite3, sys

db = os.path.expanduser("~/.omp/agent/agent.db")
if not os.path.exists(db):
    sys.exit(1)
try:
    con = sqlite3.connect(db)
    rows = con.execute(
        "SELECT provider, credential_type, data, disabled_cause, identity_key, "
        "created_at, updated_at FROM auth_credentials ORDER BY id"
    ).fetchall()
    con.close()
except sqlite3.Error:
    sys.exit(1)
if not rows:
    sys.exit(1)
print(json.dumps([
    {
        "provider": row[0],
        "credential_type": row[1],
        "data": row[2],
        "disabled_cause": row[3],
        "identity_key": row[4],
        "created_at": row[5],
        "updated_at": row[6],
    }
    for row in rows
], separators=(",", ":")))
PYEOF
}

# Merge all bundled OMP credentials into this machine's agent.db.
# Matching uses provider + credential_type + identity_key so repeated restores
# update existing accounts instead of creating duplicates, while preserving
# unrelated credentials already present on the destination.
omp_merge_auth_credentials() {
  local src="$HOME_DIR/.omp/agent/omp-auth-credentials.json"
  [[ -f "$src" ]] || return 0
  python3 - "$src" << 'PYEOF'
import json, os, sqlite3, sys

src, db = sys.argv[1], os.path.expanduser("~/.omp/agent/agent.db")
with open(src) as f:
    rows = json.load(f)
if not isinstance(rows, list):
    raise SystemExit("omp auth: invalid credential document")
if not os.path.exists(db):
    print("omp auth: agent.db not found (omp has not run here yet).")
    print("  Staged at ~/.omp/agent/omp-auth-credentials.json; start omp once,")
    print("  then re-run: devpod-bundle --restore (to finish the merge).")
    sys.exit(0)

con = sqlite3.connect(db)
try:
    for row in rows:
        key = (row["provider"], row["credential_type"], row.get("identity_key"))
        existing = con.execute(
            "SELECT id FROM auth_credentials "
            "WHERE provider = ? AND credential_type = ? AND identity_key IS ? "
            "ORDER BY id LIMIT 1",
            key,
        ).fetchone()
        values = (
            row["data"],
            row.get("disabled_cause"),
            row.get("created_at"),
            row.get("updated_at"),
        )
        if existing:
            con.execute(
                "UPDATE auth_credentials SET data = ?, disabled_cause = ?, "
                "created_at = ?, updated_at = ? WHERE id = ?",
                values + (existing[0],),
            )
        else:
            con.execute(
                "INSERT INTO auth_credentials "
                "(provider, credential_type, data, disabled_cause, identity_key, "
                "created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                (
                    row["provider"],
                    row["credential_type"],
                    row["data"],
                    row.get("disabled_cause"),
                    row.get("identity_key"),
                    row.get("created_at"),
                    row.get("updated_at"),
                ),
            )
    con.commit()
finally:
    con.close()
os.remove(src)
print(f"omp auth: merged {len(rows)} credential(s) into ~/.omp/agent/agent.db")
PYEOF
}

# Stage a pod-ready gh hosts.yml: the local one has no oauth_token (the token
# lives in the macOS keyring), so fetch it via `gh auth token` and write a
# keyring-free hosts.yml to stdout. On restore it is copied over the bundled
# hosts.yml so gh works on the pod without a keyring round-trip. Prints
# nothing (and returns 1) when gh is not authenticated here.
stage_gh_hosts_yml() {
  local token
  token="$(gh auth token 2>/dev/null)" || return 1
  [ -n "$token" ] || return 1
  GH_TOKEN="$token" python3 - "$HOME_DIR/.config/gh/hosts.yml" << 'PYEOF'
import os, re, sys

token = os.environ["GH_TOKEN"]
lines = open(sys.argv[1]).read().splitlines()
out, injected = [], False
for line in lines:
    if not injected and re.match(r"^\s*user:\s", line):
        indent = line[: len(line) - len(line.lstrip())]
        out.append(f"{indent}oauth_token: {token}")
        injected = True
    out.append(line)
if not injected:
    sys.exit(1)
print("\n".join(out) + "\n")
PYEOF
}

# --------------------------------------------------------------------------- args
OUT=""
LIST_ONLY=0
RESTORE_FILE=""
DRY_RUN=0

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)  OUT="$2"; shift 2 ;;
    --list)       LIST_ONLY=1; shift ;;
    --restore)    RESTORE_FILE="$2"; shift 2 ;;
    --dry-run)    DRY_RUN=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --------------------------------------------------------------------------- restore
if [ -n "$RESTORE_FILE" ]; then
  if [ ! -f "$RESTORE_FILE" ]; then
    echo "restore: not a file: $RESTORE_FILE" >&2
    exit 1
  fi
  if ! tar -tzf "$RESTORE_FILE" >/dev/null 2>&1; then
    echo "restore: not a gzip tar archive: $RESTORE_FILE" >&2
    exit 1
  fi

  echo "Bundle contents ($RESTORE_FILE):"
  tar -tzf "$RESTORE_FILE" | sed 's/^/  /'

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "(--dry-run: nothing extracted)"
    exit 0
  fi

  echo
  echo "Extracting into $HOME_DIR ..."
  # Skip the embedded RESTORE.txt note so it doesn't litter ~; print it below.
  tar -xzf "$RESTORE_FILE" -C "$HOME_DIR" --exclude=RESTORE.txt


  # Merge every bundled OMP provider credential into agent.db. If omp has not
  # created agent.db yet, the helper leaves the JSON staged for a later restore.
  omp_merge_auth_credentials

  # gh: the bundle's hosts.yml carries the oauth_token inline (staged from the
  # source machine's keyring), so no keyring is needed here. Verify gh sees it.
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      echo "gh auth: OK ($(gh auth status 2>&1 | grep -oE 'account [^ ]+' | head -1 | cut -d' ' -f2-) — token from bundled hosts.yml)"
    else
      echo "WARNING: gh did not accept the bundled token — run \`gh auth login\` here."
    fi
  else
    echo "gh auth: bundled at ~/.config/gh/hosts.yml (gh not installed here to verify)"
  fi

  # docker: credentials are inline in the bundled config.json. Verify docker
  # sees a Hub login when the CLI is present (docker context may not exist on
  # a fresh pod; that's fine — only the credential file matters).
  if [[ -f "$HOME_DIR/.docker/config.json" ]]; then
    n_auths="$(python3 -c "import json; print(len(json.load(open('$HOME_DIR/.docker/config.json')).get('auths', {})))" 2>/dev/null || echo '?')"
    echo "docker auth: bundled at ~/.docker/config.json (${n_auths} auth entries)"
  else
    echo "docker auth: not bundled (no ~/.docker/config.json in this bundle)"
  fi

  # Verify omp config landed (models.yml with an inline apiKey, written by
  # configure_omp in the dotfiles setup).
  if omp_models_yml_has_inline_key "$HOME_DIR/.omp/agent/models.yml"; then
    echo "omp config: OK (~/.omp/agent/models.yml with inline apiKey)"
  else
    echo "WARNING: no omp models.yml with an inline apiKey found after restore"
    echo "         — run the dotfiles setup (configure_omp) on this pod."
  fi

  if tar -tzf "$RESTORE_FILE" | grep -qx 'RESTORE.txt'; then
    echo
    echo "----- RESTORE.txt (from bundle) -----"
    tar -xzOf "$RESTORE_FILE" RESTORE.txt
    echo "----- end RESTORE.txt -----"
  fi
  exit 0
fi

# --------------------------------------------------------------------------- bundle
STAMP="$(date +%Y%m%d-%H%M%S)"
DEFAULT_OUT="$HOME_DIR/devpod-bundle-$STAMP.tar.gz"
[ -z "$OUT" ] && OUT="$DEFAULT_OUT"

# Absolute source paths. All must live under $HOME. Each entry is bundled
# recursively (if a dir) or as a single file. Built incrementally so missing
# optional files can be skipped cleanly.
abs_paths=()
labels=()

# ssh (always bundled)
abs_paths+=("$HOME_DIR/.ssh")
labels+=("ssh (dir)")

# omp (oh-my-pi): the whole agent config dir — models.yml (Baseten key inline),
# config.yml (roles + fallback chain), mcp.json (runlayer), and the AGENTS.md
# symlink. agent.db / history.db / caches are excluded (machine-local, huge).
# Bundling models.yml + config.yml is what re-auths and re-configures omp on
# the pod; --restore verifies the inline apiKey landed.
abs_paths+=("$HOME_DIR/.omp/agent/models.yml")
labels+=("omp models (Baseten provider, inline key)")
abs_paths+=("$HOME_DIR/.omp/agent/config.yml")
labels+=("omp roles + fallback chain")
abs_paths+=("$HOME_DIR/.omp/agent/mcp.json")
labels+=("omp MCP servers (runlayer)")


# factory droid
abs_paths+=(
  "$HOME_DIR/.factory/auth.v2.file"
  "$HOME_DIR/.factory/auth.v2.key"
  "$HOME_DIR/.factory/auth.v2.loginkeychain"
  "$HOME_DIR/.factory/cache/certs/factory-cli-certs.pem"
  "$HOME_DIR/.factory/settings.json"
  "$HOME_DIR/.factory/mission-readiness-warnings-shown.json"
  "$HOME_DIR/.factory/droids"
  "$HOME_DIR/.factory/crons"
)
labels+=(
  "factory droid auth (login file)"
  "factory droid auth (login key)"
  "factory droid auth (login keychain)"
  "factory droid auth (mTLS cert)"
  "factory droid settings (custom models, session defaults, trusted folders)"
  "factory droid mission prefs (readiness warnings shown)"
  "factory droid custom droids (dir)"
  "factory droid cron missions (dir)"
)


# docker CLI: auth lives inline in ~/.docker/config.json (auths with base64
# credentials + Hub access/refresh tokens, no credsStore/keyring on this
# setup), so it is fully portable as a file.
abs_paths+=("$HOME_DIR/.docker/config.json")
labels+=("docker CLI auth (Hub login + tokens, inline in config.json)")

# gh (GitHub CLI): config.yml/hosts.yml are plain files, but the OAuth token is
# in the macOS keyring on this machine (gh auth status says "(keyring)").
# Bundle the settings; the token itself is staged separately as a keyring-free
# hosts.yml (stage_gh_hosts_yml below) and written on restore.
abs_paths+=(
  "$HOME_DIR/.config/gh/config.yml"
  "$HOME_DIR/.config/gh/hosts.yml"
)
labels+=(
  "gh CLI settings"
  "gh CLI hosts (accounts + git protocol; token staged separately)"
)

# truss (Baseten) CLI
abs_paths+=("$HOME_DIR/.trussrc")
labels+=("truss CLI credentials (Baseten remotes)")

if [ "${#abs_paths[@]}" -ne "${#labels[@]}" ]; then
  echo "internal error: abs_paths/labels length mismatch" >&2
  exit 1
fi

rel_paths=()
present_labels=()
missing=()
for i in "${!abs_paths[@]}"; do
  p="${abs_paths[$i]}"
  lbl="${labels[$i]}"
  if [ ! -e "$p" ]; then
    missing+=("$lbl  ($p)")
    continue
  fi
  case "$p" in
    "$HOME_DIR"/*) rel="${p#"$HOME_DIR"/}" ;;
    *) echo "skipping path not under \$HOME: $p" >&2; continue ;;
  esac
  rel_paths+=("$rel")
  present_labels+=("$lbl -> ~/$rel")
done

# How omp credentials travel in this bundle: models.yml carries the Baseten
# key inline (written by configure_omp in the dotfiles setup). Warn loudly
# if it is missing.
omp_cred_note=""
if omp_models_yml_has_inline_key "$HOME_DIR/.omp/agent/models.yml"; then
  omp_cred_note="omp auth: bundled inline in ~/.omp/agent/models.yml (providers.baseten.apiKey)"
else
  omp_cred_note="WARNING: no omp models.yml with an inline apiKey found — omp will be unauthenticated on the pod"
fi

if [ ${#rel_paths[@]} -eq 0 ]; then
  echo "nothing to bundle (no source paths found under $HOME_DIR)" >&2
  exit 1
fi

echo "Bundling from $HOME_DIR:"
printf '  %s\n' "${present_labels[@]}"
echo "  $omp_cred_note"
if [ ${#missing[@]} -gt 0 ]; then
  echo "missing (skipped):"
  printf '  %s\n' "${missing[@]}" >&2
fi

# OMP stores provider OAuth/API credentials in agent.db. Stage the complete
# auth_credentials table so every logged-in provider travels with the bundle.
STAGE_OMP_AUTH=""
if omp_auth_credentials_json > "$HOME_DIR/.omp/agent/.auth-credentials.tmp" 2>/dev/null \
   && [ -s "$HOME_DIR/.omp/agent/.auth-credentials.tmp" ]; then
  STAGE_OMP_AUTH="omp-auth-credentials.json"
else
  rm -f "$HOME_DIR/.omp/agent/.auth-credentials.tmp"
  missing+=("omp provider credentials (none found in agent.db — log in with omp first)  (~/.omp/agent/agent.db)")
fi

# gh OAuth token: staged from the keyring into a pod-ready hosts.yml
# (.config/gh/hosts.yml) that carries oauth_token inline, overwriting the
# bundled keyring-less hosts.yml in the archive. Without this, gh on a
# keyring-less pod cannot read the token from the macOS keyring.
STAGE_GH_AUTH=""
if stage_gh_hosts_yml > "$HOME_DIR/.config/gh/.hosts-with-token.tmp" 2>/dev/null \
   && [ -s "$HOME_DIR/.config/gh/.hosts-with-token.tmp" ]; then
  STAGE_GH_AUTH="hosts.yml"
else
  rm -f "$HOME_DIR/.config/gh/.hosts-with-token.tmp"
  missing+=("gh CLI OAuth token (gh not authenticated here? run \`gh auth login\`)  (~/.config/gh)")
fi

if [ "$LIST_ONLY" -eq 1 ]; then
  if [ -n "$STAGE_OMP_AUTH" ]; then
    echo "  omp provider credentials -> ~/.omp/agent/omp-auth-credentials.json (all auth_credentials rows)"
  fi
  if [ -n "$STAGE_GH_AUTH" ]; then
    echo "  gh CLI auth -> ~/.config/gh/hosts.yml (oauth_token staged from keyring)"
  fi
  rm -f "$HOME_DIR/.omp/agent/.auth-credentials.tmp" "$HOME_DIR/.config/gh/.hosts-with-token.tmp"
  exit 0
fi

# Companion note placed at the archive root so the pod knows what it has and
# how to restore it.
TMP_BUNDLE="$HOME_DIR/.cache/devpod-bundle.$$.$RANDOM"
(umask 077 && mkdir -p "$TMP_BUNDLE")
trap 'rm -rf "$TMP_BUNDLE"' EXIT
if [ -n "$STAGE_OMP_AUTH" ]; then
  mkdir -p "$TMP_BUNDLE/.omp/agent"
  mv "$HOME_DIR/.omp/agent/.auth-credentials.tmp" "$TMP_BUNDLE/.omp/agent/omp-auth-credentials.json"
  chmod 600 "$TMP_BUNDLE/.omp/agent/omp-auth-credentials.json"
fi
# The staged hosts.yml (with oauth_token inline) is tarred as .config/gh/hosts.yml,
# overriding the keyring-less copy from $HOME (tar uses the LAST -C block for
# duplicate paths, so this must come after the -C "$HOME_DIR" entries — it does:
# both staged files are added in the final -C "$TMP_BUNDLE" group).
if [ -n "$STAGE_GH_AUTH" ]; then
  mkdir -p "$TMP_BUNDLE/.config/gh"
  mv "$HOME_DIR/.config/gh/.hosts-with-token.tmp" "$TMP_BUNDLE/.config/gh/hosts.yml"
  chmod 600 "$TMP_BUNDLE/.config/gh/hosts.yml"
fi
{
  echo "devpod-bundle"
  echo "============="
  echo "created:   $(date)"
  echo "source:    $(hostname)  (user: $(whoami), home: $HOME_DIR)"
  echo
  echo "Contents (paths relative to \$HOME):"
  printf '  %s\n' "${present_labels[@]}"
  if [ ${#missing[@]} -gt 0 ]; then
    echo
    echo "Not bundled on source host:"
    printf '  %s\n' "${missing[@]}"
  fi
  echo
  echo "Transport the bundle to the pod (any one of):"
  echo "  croc send <bundle>.tar.gz          # pod: croc <code>"
  echo "  wormhole send <bundle>.tar.gz      # pod: wormhole receive <code>"
  echo "  rsync -av <bundle>.tar.gz <pod>:   # or plain scp"
  echo
  echo "Restore on the pod:"
  echo "  ~/dotfiles/devpod-bundle --restore <bundle>.tar.gz"
  echo "  (or: cd ~ && tar -xzf <bundle>.tar.gz)"
  echo
  echo "Notes:"
  echo "  - File permissions are preserved (ssh keys stay 0600, etc.)."
  echo "  - factory droid auth (auth.v2.file + auth.v2.key) IS bundled. On the Mac"
  echo "    set FACTORY_DISABLE_KEYRING=1 so droid writes that portable pair instead"
  echo "    of the macOS login keychain (auth.v2.loginkeychain is NOT portable to"
  echo "    Linux). If the mTLS cert has expired on the pod, re-run \`factory login\`."
  echo "  - factory droid settings/preferences ARE bundled: settings.json"
  echo "    (custom models, session defaults, trusted folders), custom droids"
  echo "    (~/.factory/droids), and cron missions (~/.factory/crons)."
  echo "  - omp (oh-my-pi) config: bundled from ~/.omp/agent/ — models.yml"
  echo "    (Baseten key inline, as this dotfiles setup writes), config.yml"
  echo "    (roles + fallback chain), and mcp.json. --restore verifies the"
  echo "    inline apiKey landed. Skills/AGENTS.md symlinks come from the"
  echo "    dotfiles repo on the pod, not from this bundle."
  echo "  - $omp_cred_note"
  echo "  - truss (Baseten) credentials ARE bundled via ~/.trussrc. If the"
  echo "    remote needs re-auth on the pod, run \`truss login\`."
  echo "  - omp provider credentials (all auth_credentials rows) ARE bundled at"
  echo "    .omp/agent/omp-auth-credentials.json and merged into the pod's"
  echo "    ~/.omp/agent/agent.db on restore. This includes every OMP login;"
  echo "    re-authenticate only credentials that have expired."
  echo "  - docker CLI auth IS bundled via ~/.docker/config.json (Hub login +"
  echo "    access/refresh tokens inline; no credsStore on this setup)."
  echo "    Verify on the pod with: docker login (should already be logged in)"
  echo "    or pull a private image."
  echo "  - gh CLI auth IS bundled: config.yml + hosts.yml, where hosts.yml"
  echo "    carries the OAuth token inline (staged from the source machine's"
  echo "    keyring — the pod needs no keyring). If it has expired there,"
  echo "    re-run \`gh auth login\` on the pod. Verify: gh auth status."
} > "$TMP_BUNDLE/RESTORE.txt"

# Build the archive. Paths are stored relative to $HOME via -C "$HOME_DIR";
# RESTORE.txt and the staged OMP provider credentials / gh auth are added from
# the temp dir with a second -C. Excludes drop the stale known_hosts backup and
# any stray agent sockets.
tar_extra=()
[ -n "$STAGE_OMP_AUTH" ] && tar_extra+=(".omp/agent/omp-auth-credentials.json")
[ -n "$STAGE_GH_AUTH" ] && tar_extra+=(".config/gh/hosts.yml")
tar -czf "$OUT" \
  --exclude='.ssh/known_hosts.old' \
  --exclude='.ssh/agent' \
  -C "$HOME_DIR" "${rel_paths[@]}" \
  -C "$TMP_BUNDLE" RESTORE.txt "${tar_extra[@]}"

chmod 600 "$OUT"

echo
echo "wrote: $OUT  ($(du -h "$OUT" | cut -f1))"
echo
echo "archive contents:"
tar -tzf "$OUT" | sed 's/^/  /'
echo
echo "send it:   croc send \"$OUT\""
echo "           (or) magic-wormhole:  wormhole send \"$OUT\""
echo "                (wormhole is the ~/venv magic-wormhole CLI, symlinked"
echo "                 to ~/.local/bin/wormhole by ensure_venv in the setup)"
echo "           (or) rsync:           rsync -av \"$OUT\" <pod>:"
echo
echo "receive on the pod:"
echo "           croc           -> croc <code>          (asks for the code)"
echo "           magic-wormhole -> wormhole receive <code>   (auto-named file)"
echo "                (the pod gets the same ~/.local/bin/wormhole symlink"
echo "                 from ~/venv via ensure_venv in the dotfiles setup)"
echo
echo "restore:   ~/dotfiles/devpod-bundle --restore \"$OUT\"   (on the pod)"
