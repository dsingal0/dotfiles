#!/usr/bin/env python3
"""droid-export - export a Factory 'droid' session to a portable format.

A droid session lives as a JSONL transcript under
~/.factory/sessions/<encoded-cwd>/<session-id>.jsonl plus a <id>.settings.json.

This tool resolves a session by id (or 'last'), parses the transcript, and
emits a normalized, harness-agnostic export. The default format is JSONL (one
JSON object per line) which any downstream agent harness can ingest by reading
the file. Use --format md for a human-readable markdown transcript.

It performs NO writes to opencode (or any other harness's session store); it
only reads the droid transcript and writes the export to stdout (or -o PATH).

USAGE
  droid-export <session-id>                 # JSONL to stdout
  droid-export last                         # most-recent session
  droid-export <id> -o out.jsonl            # JSONL to file
  droid-export <id> --format md             # markdown to stdout
  droid-export <id> --format md -o out.md   # markdown to file
  droid-export --list                       # list droid sessions and exit

OUTPUT SCHEMA (JSONL)
  First line is a meta record:
    {"type":"meta","exporter":"droid-export","version":2,"droidSessionId":...,
     "cwd":...,"title":...,"exportedAt":"<iso8601>"}
  Subsequent lines are one of:
    {"type":"message","role":"user"|"assistant","id":...,"timestamp":...,
     "parent":...,"blocks":[...]}
    {"type":"todos","timestamp":...,"todos":[{"label":...,"status":...}]}
  Block shapes:
    {"type":"text","text":...}
    {"type":"reasoning","text":...}
    {"type":"tool_use","id":...,"name":...,"input":{...}}
    {"type":"tool_result","toolUseId":...,"isError":bool,"content":...}
"""
from __future__ import annotations

import argparse
import datetime as _dt
import glob
import hashlib
import json
import os
import re
import sys
import time

FACTORY = os.path.expanduser("~/.factory/sessions")
EXPORTER_VERSION = 2
# A content block is a droid/agent system reminder worth dropping from exports.
_REMINDER = "<system-reminder>"

# --------------------------------------------------------------------------- paths


def factory_session_candidates() -> list[dict]:
    out = []
    for path in glob.glob(os.path.join(FACTORY, "*", "*.jsonl")):
        b = os.path.basename(path)
        m = re.match(r"([0-9a-fA-F-]{8,})\.jsonl$", b)
        if not m:
            continue
        sid = m.group(1)
        cwd = _encoded_dir_to_cwd(os.path.basename(os.path.dirname(path)))
        st = os.stat(path)
        out.append({"id": sid, "path": path, "cwd": cwd, "mtime": st.st_mtime,
                    "size": st.st_size})
    out.sort(key=lambda r: r["mtime"], reverse=True)
    return out


def _encoded_dir_to_cwd(name: str) -> str:
    # factory encodes the cwd by replacing "/" with "-". e.g. "-root-baseten"
    if name.startswith("-"):
        return "/" + name[1:]
    return name


def resolve_session(arg: str) -> dict:
    cands = factory_session_candidates()
    if arg == "last":
        if not cands:
            raise SystemExit("no droid sessions found under " + FACTORY)
        return cands[0]
    for c in cands:
        if c["id"].startswith(arg) or arg.startswith(c["id"]):
            return c
    if os.path.isfile(arg):
        return {"id": "manual-" + hashlib.sha1(arg.encode()).hexdigest()[:12],
                "path": arg, "cwd": _guess_cwd_from_path(arg), "mtime": os.stat(arg).st_mtime}
    raise SystemExit("no droid session matching: " + arg)


def _guess_cwd_from_path(path: str) -> str:
    parent = os.path.basename(os.path.dirname(path))
    return _encoded_dir_to_cwd(parent)


# --------------------------------------------------------------------------- droid parse


def parse_droid(path: str) -> dict:
    start = None
    msgs = []
    todos = []
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            t = o.get("type")
            if t == "session_start":
                start = o
            elif t == "message":
                msgs.append(o)
            elif t == "todo_state":
                todos.append(o)
    if start is None and msgs:
        start = {"id": "unknown", "cwd": _guess_cwd_from_path(path),
                 "title": "Imported droid session"}
    return {"start": start, "messages": msgs, "todos": todos}


def _result_to_text(content) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, dict):
                if b.get("type") == "text" and b.get("text"):
                    parts.append(b["text"])
                elif b.get("type") == "image_url" or "image_url" in b:
                    parts.append("[image]")
            else:
                parts.append(str(b))
        return "\n".join(parts)
    if isinstance(content, dict):
        return json.dumps(content, ensure_ascii=False)
    return str(content)


def _visible_text(b: dict, role: str) -> str | None:
    """Return visible text for a block, or None to drop it."""
    if b.get("type") != "text":
        return None
    vis = b.get("visibility")
    text = b.get("text", "")
    # drop llm-only injected reminders on user turns (agent-internal noise)
    if role == "user" and (vis == "llm_only" or text.lstrip().startswith(_REMINDER)):
        return None
    # drop assistant-injected system-reminder blocks too
    if text.lstrip().startswith(_REMINDER):
        return None
    return text


def _normalize_todos(raw) -> list[dict]:
    """Normalize droid's varied todo_state shapes into {label,status} dicts.

    Observed shapes:
      {"todos": "1. [in_progress] ...\n2. [pending] ..."}  (TodoWrite raw input)
      [{"label": "...", "status": "..."}, ...]
      ["1. [completed] ...", ...]
      "1. [pending] ...\n..."
    """
    if isinstance(raw, dict):
        raw = raw.get("todos")
    if raw is None:
        return []
    if isinstance(raw, str):
        lines = [ln for ln in raw.splitlines() if ln.strip()]
    elif isinstance(raw, list):
        lines = raw
    else:
        return []
    items = []
    line_re = re.compile(r"^\s*\d+\.\s*\[(completed|in_progress|pending)\]\s*(.*)$")
    for ln in lines:
        if isinstance(ln, dict):
            items.append({"label": ln.get("label") or ln.get("content") or "",
                          "status": ln.get("status", "pending")})
            continue
        s = str(ln)
        m = line_re.match(s)
        if m:
            items.append({"label": m.group(2), "status": m.group(1)})
        elif s.strip():
            items.append({"label": s.strip(), "status": "pending"})
    return items


def build_export(transcript: dict) -> dict:
    """Turn a parsed droid transcript into normalized export records.

    Returns: {meta, records} where records is a list of message/todos dicts.
    """
    start = transcript["start"] or {}
    cwd = start.get("cwd") or "/"
    title = (start.get("title") or "Exported droid session").strip()
    droid_id = start.get("id")

    meta = {
        "type": "meta",
        "exporter": "droid-export",
        "version": EXPORTER_VERSION,
        "droidSessionId": droid_id,
        "cwd": cwd,
        "title": title,
        "exportedAt": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"),
    }

    msgs = transcript["messages"]
    # Pre-pass: collect tool results by tool_use_id (they arrive in the next
    # user turn) so we can fold each result into its tool_use block.
    tool_results: dict[str, tuple[str, bool]] = {}
    for o in msgs:
        mo = o.get("message", {})
        if mo.get("role") != "user":
            continue
        cl = mo.get("content")
        if not isinstance(cl, list):
            continue
        for b in cl:
            if b.get("type") == "tool_result":
                tid = b.get("tool_use_id")
                if tid:
                    tool_results[tid] = (_result_to_text(b.get("content")),
                                         bool(b.get("is_error")))

    records: list[dict] = []
    current_user_id: str | None = None

    for o in msgs:
        m = o.get("message", {})
        role = m.get("role")
        if role not in ("user", "assistant"):
            continue
        content = m.get("content")
        blocks = content if isinstance(content, list) else (
            [{"type": "text", "text": content}] if isinstance(content, str) else []
        )
        ts = o.get("timestamp")
        did = o.get("id") or ""

        if role == "user":
            results_here = [b for b in blocks if b.get("type") == "tool_result"]
            visible = [t for b in blocks
                       if (t := _visible_text(b, "user")) is not None]
            if results_here and not visible:
                # pure tool-output turn; results already folded into tool_use
                continue
            if not visible:
                continue
            mid = did or "user"
            current_user_id = mid
            out_blocks: list[dict] = [{"type": "text", "text": "\n\n".join(visible)}]
            for b in results_here:
                tid = b.get("tool_use_id")
                res = tool_results.get(tid) if tid else None
                if res is None:
                    res = (_result_to_text(b.get("content")), bool(b.get("is_error")))
                out_blocks.append({"type": "tool_result", "toolUseId": tid or "",
                                   "isError": res[1], "content": res[0]})
            records.append({"type": "message", "role": "user", "id": mid,
                            "timestamp": ts, "parent": None, "blocks": out_blocks})
            continue

        # assistant
        mid = did or "assistant"
        out_blocks = []
        for b in blocks:
            bt = b.get("type")
            if bt == "thinking":
                out_blocks.append({"type": "reasoning", "text": b.get("thinking", "")})
            elif bt == "text":
                txt = b.get("text", "")
                if txt.lstrip().startswith(_REMINDER):
                    continue
                out_blocks.append({"type": "text", "text": txt})
            elif bt == "tool_use":
                tid = b.get("id") or ""
                raw_name = b.get("name") or "tool"
                raw_inp = b.get("input")
                if isinstance(raw_inp, str):
                    raw_inp = {"value": raw_inp}
                res = tool_results.get(tid) if tid else None
                tu = {"type": "tool_use", "id": tid, "name": raw_name,
                      "input": raw_inp if raw_inp is not None else {}}
                out_blocks.append(tu)
                if res is not None:
                    out_blocks.append({"type": "tool_result", "toolUseId": tid,
                                       "isError": res[1], "content": res[0]})
        records.append({"type": "message", "role": "assistant", "id": mid,
                        "timestamp": ts, "parent": current_user_id,
                        "blocks": out_blocks})

    # todos - droid stores these in several shapes; normalize all of them.
    for t in transcript["todos"]:
        items = _normalize_todos(t.get("todos"))
        if items:
            records.append({"type": "todos", "timestamp": t.get("timestamp"),
                            "todos": items})

    return {"meta": meta, "records": records}


# --------------------------------------------------------------------------- renderers


def render_jsonl(export: dict) -> str:
    lines = [json.dumps(export["meta"], ensure_ascii=False)]
    for r in export["records"]:
        lines.append(json.dumps(r, ensure_ascii=False))
    return "\n".join(lines) + "\n"


def _fmt_time(ts: str | None) -> str:
    if not ts:
        return ""
    try:
        s = ts
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        return _dt.datetime.fromisoformat(s).strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return ts


def render_md(export: dict) -> str:
    meta = export["meta"]
    out: list[str] = []
    out.append("# %s" % meta["title"])
    out.append("")
    out.append("> **droid-export** v%d  |  session `%s`  |  cwd `%s`  |  exported %s"
               % (EXPORTER_VERSION, meta.get("droidSessionId") or "?",
                  meta.get("cwd") or "?", _fmt_time(meta.get("exportedAt"))))
    out.append("")
    out.append("---")
    out.append("")
    for r in export["records"]:
        if r["type"] == "todos":
            out.append("### Todos (%s)" % _fmt_time(r.get("timestamp")))
            out.append("")
            for it in r["todos"]:
                mark = {"completed": "x", "in_progress": "~", "pending": " "}.get(
                    it.get("status", "pending"), " ")
                out.append("- [%s] %s" % (mark, it["label"]))
            out.append("")
            continue
        role = r["role"]
        when = _fmt_time(r.get("timestamp"))
        heading = "## %s" % role.capitalize() + (("  (%s)" % when) if when else "")
        out.append(heading)
        out.append("")
        for b in r["blocks"]:
            bt = b["type"]
            if bt == "text":
                out.append(b["text"])
                out.append("")
            elif bt == "reasoning":
                out.append("<details><summary>reasoning</summary>")
                out.append("")
                out.append("```")
                out.append(b["text"])
                out.append("```")
                out.append("")
                out.append("</details>")
                out.append("")
            elif bt == "tool_use":
                out.append("**Tool: `%s`**" % b["name"])
                out.append("")
                out.append("```json")
                out.append(json.dumps(b.get("input") or {}, indent=2, ensure_ascii=False))
                out.append("```")
                out.append("")
            elif bt == "tool_result":
                content = b.get("content") or ""
                tag = " (error)" if b.get("isError") else ""
                out.append("<details><summary>result%s</summary>" % tag)
                out.append("")
                out.append("```")
                out.append(content)
                out.append("```")
                out.append("")
                out.append("</details>")
                out.append("")
        out.append("---")
        out.append("")
    return "\n".join(out)


# --------------------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser(
        prog="droid-export",
        description="Export a Factory 'droid' session to a portable JSONL or markdown file.")
    ap.add_argument("session", nargs="?", help="droid session id (or 'last', or a path)")
    ap.add_argument("--list", action="store_true", help="list droid sessions and exit")
    ap.add_argument("--format", choices=["jsonl", "md"], default="jsonl",
                    help="output format (default: jsonl)")
    ap.add_argument("-o", "--output", help="write to file (default: stdout)")
    args = ap.parse_args()

    if args.list:
        _print_list()
        return
    if not args.session:
        ap.error("session id required (or use --list). Example: droid-export last -o out.jsonl")

    spec = resolve_session(args.session)
    transcript = parse_droid(spec["path"])
    export = build_export(transcript)
    if not export["records"]:
        raise SystemExit("no transcribable messages in " + spec["path"])

    if args.format == "jsonl":
        text = render_jsonl(export)
    else:
        text = render_md(export)

    if args.output and args.output != "-":
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(text)
        n = len(export["records"])
        print("Exported %d records (%s) from session %s -> %s"
              % (n, args.format, spec["id"], args.output), file=sys.stderr)
    else:
        sys.stdout.write(text)


def _print_list():
    rows = factory_session_candidates()
    if not rows:
        print("no droid sessions under " + FACTORY)
        return
    print("%-36s  %-10s  %-6s  %s" % ("SESSION ID", "CWD", "SIZE", "MODIFIED"))
    for r in rows[:50]:
        print("%-36s  %-10s  %-6d  %s" % (
            r["id"][:36], r["cwd"], r["size"],
            _dt.datetime.fromtimestamp(r["mtime"]).strftime("%Y-%m-%d %H:%M")))


if __name__ == "__main__":
    main()
